# Server
PORT=3000
NODE_ENV=development

# Security and browser origins
SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5000,https://casen.onrender.com

# Database
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>

# Admin bootstrap account
ADMIN_NAME=
ADMIN_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://casen.onrender.com/auth/google/callback

# Email (Gmail app password)
EMAIL_USER=
EMAIL_PASS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
